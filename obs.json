{"d":2,"y":2026,"th":[90,75,50],"r":[{"g":["ដំណើរការបង្រៀន គោរពតាមជំហានកិច្ចតែងការបង្រៀន និងមានសកម្មភាពជាក់ស្ដែង\n-ដាក់លំហាត់សិស្សបានអនុវត្តច្រើន\n-ដាក់លំហាត់ឱ្យសិស្សពិភាក្សាជាដៃគូ\n-ឡើងបទ្ហាញនិងសម្របសម្រួលដោយគ្រូ\n-មានកិច្ចការផ្ទះ និងបណ្ដាំផ្ញើរបែបវិជ្ចមាន។","","-ប្រើប្រាស់សម្លេងបានល្អ \n-ស្លាយមានភាពទាក់ទាញ\n-សិស្សសកម្មចូលរួមធ្វើលំហាត់\n-ណែនាំកម្មវិធីល្អៗសម្រាប់ជំនួយដល់ការរៀន\n-មានការសម្របសម្រួលក្រោយសិស្សធ្វើបទបង្ហាញរួច\n-មានភ្ជាប់លំហាត់ហ្វឹកហាត់","","-តាមដានសិស្សបន្ថែម(ខ្លះមិនបានផ្ដោតលើអ្វីដែលគ្រូបាននិយាយ)\n-ទាញចំណាប់អារម្មណ៍សិស្សមានកម្រិត\n-ស្លាយបង្រៀនមានភាពទាក់ទាញតែអក្សរតូចបន្តិច\n-សិស្សប្រុសៗផ្នែកខាងក្រោយមិនសូវស្ដាប់និងជជែករឿងផ្សេង\n-សិស្សប្រើទូរស័ព្ទច្រើននាក់(ជាពិសេសសិស្សម្នាក់ជិតបង្អុចជាប់ទ្វា)\n-គួរកំណត់ពេលវេលាជាក់លាក់មួយដើម្បីឱ្យសិស្សមានបម្រុងប្រយ័ត្នខ្ពស់\n-ផ្ដល់ពត៍មានត្រឡប់ទៅសិស្សភ្លាមៗបានល្អប៉ុន្តែគួរប្រើពាក្យពេជ្របែបស្ថបនា ឬលើកទឹកចិត្តច្រើនកាន់តែល្អ\n-បន្ទាប់ពិភាក្សាចប់គួរណែនាំសិស្សឱ្យទូរស័ព្ទជាសវាងការប្រើខុសគោលដៅ","១. បន្ថែមកម្រិតការគ្រប់គ្រងថ្នាក់រៀន(តឹងរឹង បែបទន់ភ្លន់)\n២. លើកទឹកចិត្តសិស្សឱ្យច្រើនប្រសើរស្ដីបន្ទោស\n៣. យកចិត្តទុកដាក់លើសិស្សដែលមិនសូវយកទុកដាក់លើការរៀនសូន្រ និងវិន័យ។"],"dt":"","rm":"F-M2","ct":"៤.៤ ដាក់កន្សោមដឺក្រេទី៣ជាផលគុណកត្តា","sc":[5,4,4,3,4,4,4,4,3,3,3,4,4,3,3,4,4,4,3,3,4,3,4,3,4,3,4,4,3,4,4,4,4],"o":"T001","sub":"គណិតវិទ្យា","t":"T005","n":"35","tm":"ម៉ោង 3 (9:25 - 10:10)","ab":"0","ch":"១","cl":"M-10NGS-P2","ls":"១","cm":[]},{"ls":"","cm":[],"tm":"","ab":"","ch":"","cl":"","ct":"","g":["","","","","",""],"sc":[],"o":"T001","n":"","rm":"","t":"T001","sub":"គណិតវិទ្យា","dt":""},{"sub":"គណិតវិទ្យា","g":["","","","","",""],"rm":"","dt":"","n":"","sc":[],"t":"T001","ct":"","o":"T001","ab":"","tm":"","ch":"","cl":"","cm":[],"ls":""},{"ct":"","sc":[],"dt":"","rm":"","ls":"","g":["","","","","",""],"cm":[],"tm":"","ab":"","o":"T001","t":"T001","ch":"","cl":"","n":"","sub":"គណិតវិទ្យា"},{"ct":"","sc":[],"rm":"","dt":"","o":"T001","n":"","sub":"គណិតវិទ្យា","ls":"","t":"T001","cm":[],"g":["","","","","",""],"cl":"","ch":"","tm":"","ab":""},{